# Copy to .env (git-ignored) and fill in. Used by docker-compose and as a reference for hosting dashboards.
DB_USERNAME=chatuser
DB_PASSWORD=change-me-to-a-long-random-password
DB_ROOT_PASSWORD=change-me-too

# Only needed when NOT using docker-compose (managed MySQL, etc.):
# DB_URL=jdbc:mysql://your-db-host:3306/chatapp?sslMode=REQUIRED&serverTimezone=UTC
# DB_HOST=your-db-host
# DB_PORT=3306
# DB_NAME=chatapp
# DB_SSL_MODE=REQUIRED

# true when served over HTTPS (production). Set false only for plain-http testing.
COOKIE_SECURE=true
# Optional: allowed WebSocket origins, comma-separated. Empty = same-origin only.
# ALLOWED_ORIGINS=https://chat.example.com
